class_name HMCampaignRules
extends RefCounted
## Final work is intentional, spatial and durable. No passive mechanic or
## ordinary salvage part is granted, consumed or generated by these actions.
const BELL: Array[String] = ["bell_clamps", "bell_lower", "bell_hitch", "bell_unload"]
const REPAIR: Array[String] = ["float_reset", "weight_tension", "ratchet_align",
    "hammer_seat", "mine_duct_close", "cycle_test", "craft_prepare"]
const TASKS: Dictionary = {
    "bell_clamps": {"site": "brinewick/site_15", "tool": "crowbar",
        "title": "Remove bell retaining dogs", "offset": [-2.4,1.4,2.5]},
    "bell_lower": {"site": "brinewick/site_15", "tool": "hands",
        "title": "Operate lowering windlass", "offset": [-2.5,1.4,-1.7]},
    "bell_hitch": {"site": "brinewick/site_15", "tool": "saw",
        "title": "Prepare timber hauling sledge", "offset": [2.4,1.35,-1.8]},
    "bell_unload": {"site": "brinewick/site_02", "tool": "hands",
        "title": "Manually unload bell at boatyard", "offset": [0.0,0.0,0.0]},
    "float_reset": {"site": "brinewick/site_20", "tool": "hands",
        "title": "Clear and reset tidal float", "offset": [1.7,1.25,1.2]},
    "weight_tension": {"site": "brinewick/site_17", "tool": "crowbar",
        "title": "Retension containment counterweight", "offset": [-2.4,1.3,0.5]},
    "ratchet_align": {"site": "brinewick/site_17", "tool": "claw_hammer",
        "title": "Align corroded ratchet pawl", "offset": [1.8,1.3,-2.0]},
    "hammer_seat": {"site": "brinewick/site_15", "tool": "claw_hammer",
        "title": "Re-seat bell striker", "offset": [1.8,1.4,-2.3]},
    "mine_duct_close": {"site": "brinewick/site_18", "tool": "pickaxe",
        "title": "Close the echoing outer duct", "offset": [1.8,1.3,-1.8]},
    "cycle_test": {"site": "brinewick/site_15", "tool": "hands",
        "title": "Manually test one tidal bell cycle", "offset": [-1.5,1.4,-2.2]},
    "craft_prepare": {"site": "brinewick/site_21", "tool": "hands",
        "title": "Lower escape boat into the inlet", "offset": [-2.0,1.3,-1.5]}
}

static func sequence_for(action_id: String) -> Array[String]:
    return BELL if BELL.has(action_id) else (REPAIR if REPAIR.has(action_id) else [])

static func work_blocker(state: Dictionary, action_id: String) -> String:
    if not TASKS.has(action_id):
        return "Unknown finale mechanism"
    var progress: Dictionary = state.get("progress", {})
    if int(progress.get("act", 0)) != 4 or not progress.get("requisition_flags", []).has("req_act_04"):
        return "Complete the fourth manual requisition first"
    if String(progress.get("ending", "none")) != "none":
        return "The village's ending has already been decided"
    var knowledge: Array = progress.get("discoveries", []).duplicate()
    knowledge.append_array(progress.get("encounters", []))
    for flag: String in ["mine_voice_heard", "aldren_remains_found", "containment_understood"]:
        if not knowledge.has(flag):
            return "Examine the village's containment evidence: " + flag
    var sequence: Array[String] = sequence_for(action_id)
    var opposite: Array[String] = REPAIR if BELL.has(action_id) else BELL
    var done: Array = progress.get("finale_actions", [])
    for prior: String in opposite:
        if done.has(prior):
            return "You have already committed to the other final operation"
    var index: int = sequence.find(action_id)
    if index < 0 or done.has(action_id):
        return "This operation is not available"
    if index > 0 and not done.has(sequence[index - 1]):
        return "Complete the preceding physical operation first: " + sequence[index - 1]
    if REPAIR.has(action_id) and not knowledge.has("mara_escape_clues"):
        return "First find Mara's alternative escape plan"
    var tool: String = String(TASKS[action_id]["tool"])
    if not progress.get("tools", []).has(tool):
        return "Required tool has not been discovered: " + tool
    return ""

static func finale_blocker(state: Dictionary, ending: String) -> String:
    var progress: Dictionary = state.get("progress", {})
    if not ["bell_delivery", "repair_escape"].has(ending):
        return "Unknown ending"
    if String(progress.get("ending", "none")) != "none":
        return "An ending has already been chosen"
    if int(progress.get("act", 0)) != 4 or not progress.get("requisition_flags", []).has("req_act_04"):
        return "Complete and submit the fourth manual salvage requisition"
    var clues: Array = progress.get("discoveries", []).duplicate()
    clues.append_array(progress.get("encounters", []))
    for flag: String in ["mine_voice_heard", "aldren_remains_found", "containment_understood"]:
        if not clues.has(flag):
            return "Investigate the village first: " + flag
    if ending == "repair_escape" and not clues.has("mara_escape_clues"):
        return "Find Mara's unfinished escape evidence"
    var required: Array[String] = BELL if ending == "bell_delivery" else REPAIR
    var done: Array = progress.get("finale_actions", [])
    for action: String in required:
        if not done.has(action):
            return "Finish the hands-on work before signing: " + action.replace("_", " ")
    return ""

static func required_site(ending: String) -> String:
    return "brinewick/site_15" if ending == "bell_delivery" else "brinewick/site_21"
